APP_NAME=CartPing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartping
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / Queue / Cache / Broadcast
# ---------------------------------------------------------------------------
# Defaults below are shared-hosting friendly (no Redis, no WebSocket server).
# For a VPS with Redis + Reverb, switch to the commented values instead.
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue: 'database' works on shared hosting (no daemon needed for sync in dev,
# and 'database' + a cron runner for production). Use 'redis' when Redis exists.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (only used if you enable the redis options above / Horizon)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcast: 'log' prevents crashes on hosts without a WebSocket server.
# Set 'reverb' only when you can run `php artisan reverb:start` (Linux VPS).
BROADCAST_CONNECTION=log

# Laravel Horizon (queue workers) — needs Redis + pcntl (Linux only)
HORIZON_PREFIX=cartping_
HORIZON_DEFAULT_QUEUE=default
HORIZON_HIGH_QUEUE=high
HORIZON_MEDIUM_QUEUE=medium
HORIZON_LOW_QUEUE=low
HORIZON_WEBHOOK_QUEUE=webhooks

# ---------------------------------------------------------------------------
# Laravel Reverb (real-time chat inbox websockets) — only for Linux VPS
# ---------------------------------------------------------------------------
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_HOSTNAME=localhost
REVERB_SERVER_SCHEME=http
REVERB_SERVER_ORIGINS=http://localhost:8000
REVERB_APP_ID=cartping-local
REVERB_APP_KEY=cartping-key
REVERB_APP_SECRET=cartping-secret

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_SERVER_PORT}"
VITE_REVERB_SCHEME="${REVERB_SERVER_SCHEME}"

# ---------------------------------------------------------------------------
# Shopify App (OAuth mode)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,read_script_tags,write_script_tags,read_checkouts,write_checkouts,read_shopify_payments,read_inventory,read_recurring_application_charges,write_recurring_application_charges
# Shopify API version (current as of 2026). Update quarterly.
SHOPIFY_API_VERSION=2026-07
# MUST exactly match one of the app's "Allowed redirection URL(s)" in Shopify.
# Defaults to {APP_URL}/auth/shopify/callback — set explicitly if your domain differs.
SHOPIFY_REDIRECT_URI=
SHOPIFY_APP_HMAC_SECRET=
# Billing via Shopify Billing API. Set false in production for real charges.
SHOPIFY_BILLING_TEST=true
SHOPIFY_EMBEDDED=true

# ---------------------------------------------------------------------------
# WhatsApp providers
# ---------------------------------------------------------------------------
# Meta Cloud API defaults (used when a merchant does not override per-store)
WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_WEBHOOK_SECRET=

# Whatify provider defaults (External API — API key based)
WHATIFY_BASE_URL=https://whatify.in/api/v1/external
WHATIFY_API_KEY=
WHATIFY_API_SECRET=
WHATIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI (OpenRouter — GPT-4o & free reasoning models)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default conversational model. Use openai/gpt-4o or any OpenRouter model id.
AI_MODEL=openai/gpt-4o
# Free reasoning model for task/JSON extraction (used by the template wizard & agent planner)
AI_REASONING_MODEL=nvidia/nemotron-3.5-lightning:free
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1200
# An HTTP referrer + site for OpenRouter attribution (optional)
OPENROUTER_HTTP_REFERER=
OPENROUTER_SITE_URL=

# ---------------------------------------------------------------------------
# Analytics / attribution
# ---------------------------------------------------------------------------
ATTRIBUTION_WINDOW_HOURS=24
META_ACCESS_TOKEN=
META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Widget default
# ---------------------------------------------------------------------------
WIDGET_SESSION_COOKIE=cp_widget
WIDGET_EXIT_POPUP_DELAY_MS=2000

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Services / integrations
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
