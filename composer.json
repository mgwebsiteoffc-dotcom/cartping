{
    "name": "cartping/cartping",
    "type": "project",
    "description": "WhatsApp Automation SaaS for Shopify merchants (Meta Cloud API / Whatify, GPT-4o via OpenRouter, Laravel Reverb inbox).",
    "keywords": ["laravel", "shopify", "whatsapp", "reverb", "openrouter"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.48",
        "laravel/reverb": "^1.0",
        "laravel/tinker": "^3.0",
        "nesbot/carbon": "^3.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan storage:link --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74,#a7f3d0\" \"php artisan serve\" \"php artisan queue:work --tries=3 --queue=high,default,webhooks,low\" \"php artisan reverb:start --debug\" \"npm run dev\""
        ],
        "deploy": [
            "@php artisan optimize:clear",
            "@php artisan migrate --force",
            "@php artisan config:cache",
            "@php artisan view:cache"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-pcntl": "8.3.0",
            "ext-posix": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
